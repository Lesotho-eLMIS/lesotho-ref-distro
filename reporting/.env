# Superset versions
OL_SUPERSET_VERSION=6.0.0
OL_SUPERSET_PATCHUP_VERSION=master

# Dependencies versions (defaults from root .env)
OL_POSTGRES_VERSION=12-debezium
OL_RSYSLOG_VERSION=1
OL_NGINX_VERSION=latest

# Infrastructure defaults
SYSLOG_UDP_PORT=514
SCALYR_DOCKER_SOCK=/var/run/docker.sock

# Nifi and Confluent (guessed defaults, can be overridden)
OL_NIFI_VERSION=1.16.3
NIFI_JVM_HEAP_INIT=1g
NIFI_JVM_HEAP_MAX=2g
OL_CONFLUENT_VERSION=7.0.1
